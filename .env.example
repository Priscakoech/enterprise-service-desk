# ============================================================
# Backend environment variables
# Copy this to backend/.env for local dev
# Set these in Railway dashboard for production
# ============================================================

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# Database — Railway auto-provides DATABASE_URL for managed Postgres.
# For local dev, leave blank to use SQLite.
DATABASE_URL=

# Hosts & CORS — set to your Railway domains in prod
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Admin seeding — set real credentials in prod!
# The seed_admin command runs on every deploy but is idempotent
# (won't create duplicates if admin already exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@servicedesk.local

# ============================================================
# Frontend environment variables (set in Railway frontend service)
# ============================================================

# VITE_API_URL=https://your-backend.up.railway.app/api
